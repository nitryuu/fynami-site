---
import { Image } from "astro:assets";
import FynamiLogo from "@assets/fynami.png";
---

<aside class="container mx-auto mb-20 flex items-center justify-between p-4">
  <a href="/fynami-site">
    <Image
      src={FynamiLogo}
      alt="Fynami"
      class="object-contain"
      width={140}
      height={35}
    />
  </a>
  <nav class="flex items-center gap-x-4">
    <a
      title="Privacy Policy"
      href="/fynami-site/privacy-policy"
      class="inline-flex drop-shadow drop-shadow-white/20 transition-all hover:drop-shadow-white/60"
    >
      <span class="iconify material-symbols-light--privacy-tip-outline size-9"
      ></span>
    </a>
    <a
      title="Contact"
      href="mailto:fynami.team@gmail.com"
      target="_blank"
      class="inline-flex drop-shadow drop-shadow-white/20 transition-all hover:drop-shadow-white/60"
    >
      <span class="iconify material-symbols-light--mail-outline size-9"></span>
    </a>
  </nav>
</aside>
